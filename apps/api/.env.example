# Copy to apps/api/.env
# Postgres (docker compose up -d db, or Supabase in production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fieldshift
# Local without Docker (Windows): comment the line above and use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./fieldshift.db
PACKS_DIR=../../packs
DATA_DIR=../../data
FRONTEND_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MIN=60
LOG_LEVEL=info
